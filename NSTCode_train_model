{"cells":[{"cell_type":"markdown","id":"3910c48c","metadata":{"papermill":{"duration":0.004182,"end_time":"2026-09-25T18:27:53.546113+00:00","exception":false,"start_time":"2026-09-25T18:27:53.541931+00:00","status":"completed"},"tags":[]},"source":["# import lib"]},{"cell_type":"code","execution_count":1,"id":"69221d90","metadata":{"execution":{"iopub.execute_input":"2026-09-25T18:27:53.555024Z","iopub.status.busy":"2026-09-25T18:27:53.55433Z","iopub.status.idle":"2026-09-25T18:28:05.227038Z","shell.execute_reply":"2026-09-25T18:28:05.226372Z"},"papermill":{"duration":11.679019,"end_time":"2026-09-25T18:28:05.228789+00:00","exception":false,"start_time":"2026-09-25T18:27:53.54977+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import torch\n","import torch.nn as nn\n","from torch.utils.data import Dataset\n","from torch.utils.data import DataLoader\n","import torch.optim as optim\n","\n","from torchvision import transforms\n","from PIL import Image, ImageFile\n","from tqdm import tqdm  # comman library use to tracking loop\n","from torchvision.utils import save_image\n","from pathlib import Path\n","\n","import os\n","\n","ImageFile.LOAD_TRUNCATED_IMAGES = True"]},{"cell_type":"markdown","id":"5c5d7815","metadata":{"papermill":{"duration":0.003424,"end_time":"2026-09-25T18:28:05.235844+00:00","exception":false,"start_time":"2026-09-25T18:28:05.23242+00:00","status":"completed"},"tags":[]},"source":["# Utilis"]},{"cell_type":"code","execution_count":2,"id":"d85e8f04","metadata":{"execution":{"iopub.execute_input":"2026-09-25T18:28:05.243132Z","iopub.status.busy":"2026-09-25T18:28:05.242797Z","iopub.status.idle":"2026-09-25T18:28:05.250039Z","shell.execute_reply":"2026-09-25T18:28:05.249319Z"},"papermill":{"duration":0.012753,"end_time":"2026-09-25T18:28:05.251546+00:00","exception":false,"start_time":"2026-09-25T18:28:05.238793+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class ImageFolderDataset(Dataset):\n","    def __init__(self, root, transform=None):\n","        super(ImageFolderDataset, self).__init__()\n","        self.root = Path(root)\n","        self.transform = transform\n","\n","        self.files = []\n","\n","        for path  in self.root.rglob('*'):\n","\n","            # skip dir\n","            if not path.is_file():\n","                continue\n","\n","            # check image extension\n","            if path.suffix.lower() not in ['.jpg', '.jpeg', '.png']:\n","                continue\n","\n","            # check whether image can actually be loaded\n","            try:\n","                with Image.open(path) as img:\n","                    img.load()\n","                    \n","                self.files.append(path)\n","                \n","            except Exception as e:\n","                print(f\"Skipping corrupted image: {path}\")\n","                print(f\"Reason: {e}\")\n","\n","        print(f\"Found {len(self.files)} vaild images in {self.root}\")\n","\n","    def __len__(self):\n","        return len(self.files)\n","    \n","    def __getitem__(self, index):\n","        image_path = self.files[index]\n","        image = Image.open(image_path).convert('RGB')\n","        \n","        if self.transform:\n","            image = self.transform(image)\n","        \n","        return image"]},{"cell_type":"code","execution_count":3,"id":"3086076c","metadata":{"execution":{"iopub.execute_input":"2026-09-25T18:28:05.258785Z","iopub.status.busy":"2026-09-25T18:28:05.258592Z","iopub.status.idle":"2026-09-25T18:28:05.264028Z","shell.execute_reply":"2026-09-25T18:28:05.263227Z"},"papermill":{"duration":0.010969,"end_time":"2026-09-25T18:28:05.265699+00:00","exception":false,"start_time":"2026-09-25T18:28:05.25473+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\"\"\" Extract the statistical signature mean & std of an image layer \"\"\"\n","def calc_mean_std(feat, eps=1e-5):\n","    \n","    # gets structural dim of the incoming feature map tensor\n","    size = feat.size() # [batch_size, channels, h, w]\n","\n","    assert (len(size) == 4) # safty check, ensures the tensor is exactly 4-dim\n","\n","    batch_size, channels = size[:2]\n","\n","    feat_mean = feat.view(batch_size, channels, -1).mean(dim=2).view(batch_size, channels, 1, 1)\n","    feat_var = feat.view(batch_size, channels, -1).var(dim=2, unbiased=False) + eps\n","    feat_std = feat_var.sqrt().view(batch_size,channels, 1, 1)\n","    \n","    # feat_mean => calculate average color position\n","    # feat_std => calc texture strength\n","    return feat_mean, feat_std"]},{"cell_type":"code","execution_count":4,"id":"73dd344a","metadata":{"execution":{"iopub.execute_input":"2026-09-25T18:28:05.273107Z","iopub.status.busy":"2026-09-25T18:28:05.272881Z","iopub.status.idle":"2026-09-25T18:28:05.277974Z","shell.execute_reply":"2026-09-25T18:28:05.277111Z"},"papermill":{"duration":0.010888,"end_time":"2026-09-25T18:28:05.279629+00:00","exception":false,"start_time":"2026-09-25T18:28:05.268741+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\n","\"\"\" takes content layout and paints the style statistics right over it\"\"\"\n","def adaptive_instance_normalization(content_feat, style_feat):\n","    # [batch_size, channels, h, w]\n","    size = content_feat.size()\n","\n","    style_mean, style_std = calc_mean_std(style_feat) # extract artistic style signature\n","    content_mean, content_std = calc_mean_std(content_feat) # extract original lighting and texture signature\n","    \n","    \"\"\" Wiping the Slate clean - Normalization\"\"\"\n","    # .expand(size): stretches and duplicate, [1, 512, 1, 1] => [1, 512, 28, 28]\n","    # subtraction : subtracts the average brightness from every pixel. this erase the original color casting and lighting.\n","    # Divides every pixel by the origin std, this flattens out the original image's texture and native contrast.\n","    # normalized_content_feat is now a blank structural blueprint centered at a mean of 0 and variance of 1.\n","    normalized_content_feat = (content_feat - content_mean.expand(size)) / content_std.expand(size)\n","\n","    \"\"\" Painting the new style \"\"\"\n","    # style_std.expand(size): Stretches the artwork's contrast/texture value to match the image dimensions.\n","    # normalized_content_feat * style_std...: Multiplies the blank blueprint by the artwork's standard deviation. This injects the brushstroke crispness and texture intensity of the style.\n","    # style_mean.expand(size): Stretches the artwork's color palette value to match the image dimensions.\n","    # + style_mean...: Shifts the values up or down by adding the style's mean. This injects the global color scheme and lighting palette of the artwork.\n","    return normalized_content_feat * style_std.expand(size) + style_mean.expand(size)"]},{"cell_type":"markdown","id":"f5896b68","metadata":{"papermill":{"duration":0.003449,"end_time":"2026-09-25T18:28:05.286277+00:00","exception":false,"start_time":"2026-09-25T18:28:05.282828+00:00","status":"completed"},"tags":[]},"source":["# VGG-19 Encoder architecture"]},{"cell_type":"code","execution_count":5,"id":"ca869ace","metadata":{"execution":{"iopub.execute_input":"2026-09-25T18:28:05.294558Z","iopub.status.busy":"2026-09-25T18:28:05.293851Z","iopub.status.idle":"2026-09-25T18:28:05.308394Z","shell.execute_reply":"2026-09-25T18:28:05.307568Z"},"papermill":{"duration":0.020386,"end_time":"2026-09-25T18:28:05.310053+00:00","exception":false,"start_time":"2026-09-25T18:28:05.289667+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# define the standard VGG-19 Encoder architecture (Convolutional backbone of VGG-19)\n","class VGGEncoder(nn.Module):\n","    def __init__(self, vgg_path):\n","        super(VGGEncoder, self).__init__()\n","\n","        # Define the complete VGG-19 structure so the weights file fits perfectly\n","            # all Relu are the checkpoints inside the brain of the VGG network. Each checkpoint sees our image at a different level of details.\n","            # VGG devide into 5 major blocks and each block have multiple convolutional layers.\n","            # as we go from Block 1 to 5: the network zoom out, shrinking the image size but looking at bigger patterns. \n","        self.vgg = nn.Sequential(\n","            nn.Conv2d(3, 3, (1, 1)), # 1x1 convolution acts as a learnable color space or normalization transformation, before feature extraction starts.\n","            nn.ReflectionPad2d((1, 1, 1, 1)), #  Reflection padding mirrors the pixel values at the borders, instead of black border\n","            nn.Conv2d(3, 64, (3, 3)),\n","            nn.ReLU(), # relu1-1 (index: 3)\n","\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(64, 64, (3, 3)),\n","            nn.ReLU(), # relu1-2\n","\n","\n","            nn.MaxPool2d((2, 2),  (2, 2), (0, 0), ceil_mode=True), # ceil_mode -> handles odd-dimension spatial feature, ensure feature edge details are not cut off. \n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(64, 128, (3, 3)),\n","            nn.ReLU(), # relu2-1 (index: 10)\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(128, 128, (3, 3)),\n","            nn.ReLU(), # relu2-2\n","\n","            # relu1 & relue2 => capture the fine texture of style painting | they see the tiny details.\n","\n","            nn.MaxPool2d((2, 2), (2, 2), (0, 0), ceil_mode=True),\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(128, 256, (3, 3)),\n","            nn.ReLU(), # relu3-1 (index: 17)\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(256, 256, (3, 3)),\n","            nn.ReLU(), # relu3-2\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(256, 256, (3, 3)),\n","            nn.ReLU(), # relu3-3\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(256, 256, (3, 3)),\n","            nn.ReLU(), # relu3-4\n","            \n","            # relu3 => it sees complex textures and geometric arrangments. and start recognizing wave patterns, repetitive tile shapes, and shading. \n","\n","            nn.MaxPool2d((2, 2), (2, 2), (0, 0), ceil_mode=True),\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(256, 512, (3, 3)),\n","            nn.ReLU(), # relu4-1 (index: 30), this is the last layer used - Content layer\n","\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(512, 512, (3, 3)),\n","            nn.ReLU(), # relu4-2\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(512, 512, (3, 3)),\n","            nn.ReLU(), # relu4-3\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(512, 512, (3, 3)),\n","            nn.ReLU(), # relu4-4\n","\n","            nn.MaxPool2d((2, 2), (2, 2), (0, 0), ceil_mode=True),\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(512, 512, (3, 3)),\n","            nn.ReLU(), # relu5-1\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(512, 512, (3, 3)),\n","            nn.ReLU(), # relu5-2\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(512, 512, (3, 3)),\n","            nn.ReLU(), # relu5-3\n","            nn.ReflectionPad2d((1, 1, 1, 1)),\n","            nn.Conv2d(512, 512, (3, 3)),\n","            nn.ReLU(), # relu5-4\n","        )\n","        \n","        # load the pre-trained weights\n","        self.vgg.load_state_dict(torch.load(vgg_path))\n","        self.vgg = nn.Sequential(*list(self.vgg.children())[:31]) # take only first 31 layers (index 0 -> 30 relu4-1)\n","        \n","        # splitting VGG into 4 seprate Mini-networks \n","        enc_layers = list(self.vgg.children())\n","        self.enc_1 = nn.Sequential(*enc_layers[:4]) # ends at relu1-1\n","        self.enc_2 = nn.Sequential(*enc_layers[4:11]) # ends at relu2-1\n","        self.enc_3 = nn.Sequential(*enc_layers[11:18]) # ends at relu3-1\n","        self.enc_4 = nn.Sequential(*enc_layers[18:31]) # ends at relu4-1\n","\n","        # freeze all parameters :- because VGG is not train\n","        for name in ['enc_1', 'enc_2', 'enc_3', 'enc_4']:\n","            for param in getattr(self, name).parameters():\n","                param.requires_grad = False\n","        \n","    def forward(self, input, test=False):\n","        h1 = self.enc_1(input)\n","        h2 = self.enc_2(h1)\n","        h3 = self.enc_3(h2)\n","        h4 = self.enc_4(h3)\n","\n","        # h1,h2,h3 => only used to loss compute\n","        if test:\n","            return h4\n","        return h1, h2, h3, h4"]},{"cell_type":"markdown","id":"5a80e8c4","metadata":{"papermill":{"duration":0.003199,"end_time":"2026-09-25T18:28:05.316421+00:00","exception":false,"start_time":"2026-09-25T18:28:05.313222+00:00","status":"completed"},"tags":[]},"source":["## Pretraind VGG-19 download"]},{"cell_type":"code","execution_count":6,"id":"2f61e870","metadata":{"execution":{"iopub.execute_input":"2026-09-25T18:28:05.32426Z","iopub.status.busy":"2026-09-25T18:28:05.323728Z","iopub.status.idle":"2026-09-25T18:28:06.284283Z","shell.execute_reply":"2026-09-25T18:28:06.283513Z"},"papermill":{"duration":0.96615,"end_time":"2026-09-25T18:28:06.285872+00:00","exception":false,"start_time":"2026-09-25T18:28:05.319722+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["--2026-09-25 18:28:05--  https://github.com/naoto0804/pytorch-AdaIN/releases/download/v0.0.0/vgg_normalised.pth\r\n","Resolving github.com (github.com)... 140.82.114.3\r\n","Connecting to github.com (github.com)|140.82.114.3|:443... connected.\r\n","HTTP request sent, awaiting response... 302 Found\r\n","Location: https://release-assets.githubusercontent.com/github-production-release-asset/112338125/d6ae2603-8f3e-4c58-98af-1a248448781e?sp=r&sv=2018-11-09&sr=b&spr=https&se=2026-09-25T